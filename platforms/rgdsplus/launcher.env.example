# Copy to data/launcher.env and adjust. The launcher sources this file right
# before starting rgdsplus-charge-tune.

# Which screen shows the UI (SDL display index: 0 = top, 1 = bottom) or
# rotate it. Without -screen the UI follows the system "swap screens" setting.
# CHARGETUNE_ARGS="-screen 1"
# CHARGETUNE_ARGS="-rotate 90"

# A/B and X/Y. The launcher uses the button labels (A confirms, B goes
# back). If they come out swapped, switch to the Nintendo-style swap:
# export FLIP_FACE_BUTTONS=0

# Keyboard events are ignored because the firmware exposes the controls as a
# keyboard too (double presses). To accept them again:
# export DISABLE_KEYBOARD_INPUT=0

# Controller mapping line in SDL2 gamecontrollerdb format:
# export SDL_GAMECONTROLLERCONFIG="<guid>,ANBERNIC-rk3568-keys,a:b0,b:b1,..."

# Verbose app log:
# export CHARGETUNE_DEBUG=1
